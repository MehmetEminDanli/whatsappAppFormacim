# Google AI Studio API Anahtarı (https://aistudio.google.com/app/apikey adresinden alabilirsiniz)
GEMINI_API_KEY=BURAYA_GEMINI_API_KEY_YAZIN

# Kullanılacak Gemini Modeli (gemini-3.5-flash-lite veya gemini-3.8-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# Botun yalnızca özel mesajlara yanıt verip vermeyeceği (true = gruplara cevap vermez)
IGNORE_GROUPS=true

# Botun kendi mesajlarına yanıt vermemesi (true olmalıdır)
IGNORE_ME=true

# Sohbet geçmişi hafıza süresi (dakika cinsinden, varsayılan: 30)
SESSION_TIMEOUT_MINUTES=30

# Satış temsilcisi müşteriye yazdığında botun otomatik sessize alınma süresi (dakika cinsinden, varsayılan: 120)
HANDOFF_TIMEOUT_MINUTES=120

